%YAML 1.2
---
name: Mosaic
scope: source.mosaic
file_extensions:
  - mosaic
  - mos
  - ms

contexts:
  main:
    - include: comments
    - include: annotations
    - include: strings
    - include: characters
    - include: numbers
    - include: keywords
    - include: types
    - include: functions
    - include: operators
    - include: punctuation
    - include: identifiers

  comments:
    - match: '///.*$'
      scope: comment.line.documentation.mosaic
    - match: '//.*$'
      scope: comment.line.double-slash.mosaic
    - match: '/\*'
      scope: punctuation.definition.comment.begin.mosaic
      push: block-comment

  block-comment:
    - meta_scope: comment.block.mosaic
    - match: '/\*'
      push: block-comment
    - match: '\*/'
      scope: punctuation.definition.comment.end.mosaic
      pop: true

  annotations:
    - match: '(@)(\w+)'
      captures:
        1: punctuation.definition.annotation.mosaic
        2: entity.name.annotation.mosaic

  strings:
    - match: 'r#"'
      scope: punctuation.definition.string.begin.mosaic
      push: raw-hashed-string
    - match: 'r"'
      scope: punctuation.definition.string.begin.mosaic
      push: raw-string
    - match: '#"'
      scope: punctuation.definition.string.begin.mosaic
      push: hashed-string
    - match: '"'
      scope: punctuation.definition.string.begin.mosaic
      push: double-quoted-string

  raw-hashed-string:
    - meta_scope: string.quoted.double.raw.mosaic
    - match: '"#'
      scope: punctuation.definition.string.end.mosaic
      pop: true

  raw-string:
    - meta_scope: string.quoted.double.raw.mosaic
    - match: '"'
      scope: punctuation.definition.string.end.mosaic
      pop: true

  hashed-string:
    - meta_scope: string.quoted.double.raw.hashed.mosaic
    - include: string-interpolation
    - match: '"#'
      scope: punctuation.definition.string.end.mosaic
      pop: true

  double-quoted-string:
    - meta_scope: string.quoted.double.mosaic
    - include: string-escape
    - include: string-interpolation
    - match: '"'
      scope: punctuation.definition.string.end.mosaic
      pop: true

  string-escape:
    - match: '\\(n|r|t|\\|"|0|''|\$|u\{[0-9a-fA-F]+\})'
      scope: constant.character.escape.mosaic
    - match: '\\\s*\n'
      scope: constant.character.escape.newline.mosaic

  string-interpolation:
    - match: '(\$)\{'
      captures:
        0: punctuation.definition.interpolation.begin.mosaic
      push: interpolation-body
    - match: '(\$)(\w+)'
      captures:
        1: punctuation.definition.interpolation.mosaic
        2: variable.other.interpolated.mosaic

  interpolation-body:
    - meta_scope: meta.interpolation.mosaic
    - match: '\}'
      scope: punctuation.definition.interpolation.end.mosaic
      pop: true
    - include: main

  characters:
    - match: '''(\\(n|r|t|\\|''|0|"|u\{[0-9a-fA-F]+\})|[^''\\])'''
      scope: string.quoted.single.mosaic
      captures:
        1: constant.character.mosaic

  numbers:
    - match: '#[0-9a-fA-F]{3,8}\b'
      scope: constant.numeric.hex-color.mosaic
    - match: '\b[0-9][0-9_]*(\.[0-9][0-9_]*)?(px|em|rem|%)\b'
      scope: constant.numeric.length.mosaic
    - match: '\b[0-9][0-9_]*(\.[0-9][0-9_]*)?(ms|s)\b'
      scope: constant.numeric.duration.mosaic
    - match: '\b0x[0-9a-fA-F][0-9a-fA-F_]*\b'
      scope: constant.numeric.hex.mosaic
    - match: '\b0o[0-7][0-7_]*\b'
      scope: constant.numeric.octal.mosaic
    - match: '\b0b[01][01_]*\b'
      scope: constant.numeric.binary.mosaic
    - match: '\b[0-9][0-9_]*\.[0-9][0-9_]*([eE][+-]?[0-9][0-9_]*)?\b'
      scope: constant.numeric.float.mosaic
    - match: '\b[0-9][0-9_]*[eE][+-]?[0-9][0-9_]*\b'
      scope: constant.numeric.float.scientific.mosaic
    - match: '\b[0-9][0-9_]*\b'
      scope: constant.numeric.integer.mosaic

  keywords:
    - match: '\b(if|else|then|match|case|for|in|while|loop|break|continue|return)\b'
      scope: keyword.control.flow.mosaic
    - match: '\b(let|var|const|func|struct|enum|trait|impl|component|type|extern|module)\b'
      scope: keyword.declaration.mosaic
    - match: '\b(import|from)\b'
      scope: keyword.other.import.mosaic
    - match: '\b(pub|pkg|mut|owned|weak|ref|async|await)\b'
      scope: storage.modifier.mosaic
    - match: '\b(as|is|throw|try|catch)\b'
      scope: keyword.operator.expression.mosaic
    - match: '\b(on|bind|use|set|with)\b'
      scope: keyword.other.view.mosaic
    - match: '\b(state|property|computed|event|slot|template|context|consume|native|provide|emit|attach|transition|animate|shallow|deep|mount|unmount|view|when|watch|op)\b'
      scope: keyword.other.soft.mosaic
    - match: '\b(true|false|none)\b'
      scope: constant.language.mosaic
    - match: '\b(self)\b'
      scope: variable.language.self.mosaic
    - match: '\b(Self)\b'
      scope: entity.name.type.self.mosaic
    - match: '\b(macro|where|static|unsafe|yield|spawn|select|defer|protocol|extension|super)\b'
      scope: keyword.reserved.mosaic

  types:
    - match: '\b(int|int8|int16|int32|int64|uint|uint8|uint16|uint32|uint64|float|float32|float64|bool|char|string|length|duration|color)\b'
      scope: storage.type.primitive.mosaic
    - match: '\b[A-Z][A-Za-z0-9_]*\b'
      scope: entity.name.type.mosaic

  functions:
    - match: '\b(func)\s+([a-z_][A-Za-z0-9_]*)'
      captures:
        1: keyword.declaration.mosaic
        2: entity.name.function.mosaic
    - match: '\b([a-z_][A-Za-z0-9_]*)\s*(?=\()'
      captures:
        1: entity.name.function.call.mosaic

  operators:
    - match: '(\+=|-=|\*=|/=|%=|=(?!=))'
      scope: keyword.operator.assignment.mosaic
    - match: '(==|!=|<=|>=|<|>)'
      scope: keyword.operator.comparison.mosaic
    - match: '(&&|\|\||!(?!=))'
      scope: keyword.operator.logical.mosaic
    - match: '(\+\+|--|\+|-|\*|/|%)'
      scope: keyword.operator.arithmetic.mosaic
    - match: '(<<|>>|&(?!&)|\|(?!\|)|\^|~)'
      scope: keyword.operator.bitwise.mosaic
    - match: '(->|=>)'
      scope: keyword.operator.arrow.mosaic
    - match: '(\.\.\.|\.\.=|\.\.|\.)'
      scope: keyword.operator.range.mosaic
    - match: '(\?\?|\?\.|\?)'
      scope: keyword.operator.optional.mosaic
    - match: '\$(?=\.|\w)'
      scope: variable.other.anonymous.mosaic

  punctuation:
    - match: '\.'
      scope: punctuation.separator.dot.mosaic
    - match: ','
      scope: punctuation.separator.comma.mosaic
    - match: ':'
      scope: punctuation.separator.colon.mosaic
    - match: ';'
      scope: punctuation.terminator.semicolon.mosaic
    - match: '\{'
      scope: punctuation.section.braces.begin.mosaic
    - match: '\}'
      scope: punctuation.section.braces.end.mosaic
    - match: '\('
      scope: punctuation.section.parens.begin.mosaic
    - match: '\)'
      scope: punctuation.section.parens.end.mosaic
    - match: '\['
      scope: punctuation.section.brackets.begin.mosaic
    - match: '\]'
      scope: punctuation.section.brackets.end.mosaic
    - match: '\^'
      scope: punctuation.definition.marker.mosaic

  identifiers:
    - match: '\b[a-z_][A-Za-z0-9_]*\b'
      scope: variable.other.mosaic
